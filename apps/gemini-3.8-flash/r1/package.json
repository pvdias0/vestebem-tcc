{
  "name": "vestebem",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação web de e-commerce VesteBem",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run preview",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  }
}
