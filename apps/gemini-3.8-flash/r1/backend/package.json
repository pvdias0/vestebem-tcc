{
  "name": "vestebem-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API da loja VesteBem com Node.js 24, Express 5 e SQLite",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
