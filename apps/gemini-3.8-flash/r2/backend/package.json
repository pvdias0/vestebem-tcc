{
  "name": "vestebem-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsc && node dist/db/runMigrationsCli.js",
    "db:seed": "tsc && node dist/db/seed.js",
    "dev": "tsc && node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "typescript": "^5.8.2"
  }
}
